{
  "name": "deckgl-examples-swiss-splat-terrain",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "vite --config vite.config.mjs --open",
    "start-local": "DECK_SOURCE=1 vite --config vite.config.mjs",
    "build": "vite build --config vite.config.mjs",
    "typecheck": "tsc --noEmit",
    "bake": "node --experimental-strip-types --no-warnings scripts/bake-splat-scene.ts",
    "simulate-lod": "node --experimental-strip-types --no-warnings scripts/simulate-lod.ts",
    "bake-terrain": "node --experimental-strip-types --no-warnings scripts/bake-terrain-splats.ts",
    "verify-terrain": "node --experimental-strip-types --no-warnings scripts/verify-terrain-archive.ts"
  },
  "dependencies": {
    "@deck.gl/core": "^9.4.0",
    "@deck.gl/geo-layers": "^9.4.0",
    "@deck.gl/react": "^9.4.0",
    "@luma.gl/core": "^9.4.2",
    "@luma.gl/splats": "^9.4.2",
    "@luma.gl/webgl": "^9.4.2",
    "@luma.gl/webgpu": "^9.4.2",
    "@math.gl/core": "^4.1.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "apache-arrow": "^21.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "sharp": "^0.35.4",
    "typescript": "^5.9.0",
    "vite": "^7.3.3"
  }
}
